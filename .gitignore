.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Database files (app_runtime.dat is the default DATABASE_PATH filename - see
# src/backend/src/database/index.ts - deliberately named to not look like a database)
*.db
*.db.tmp
*.dat
*.dat.tmp
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
data/

# Auto-generated database encryption key (see src/backend/src/database/encryption.ts) -
# deliberately named to not look like a key
.runtime_idx

# Auto-generated JWT signing secret (see src/backend/src/utils/jwt.ts)
.runtime_jwt

# Temporary files
tmp/
temp/

# Electron build outputs
release/
out/
*.app
*.exe
*.dmg
*.zip
*.AppImage

# Electron assets (icons generated from source)
assets/

# Compiled Electron files (keep source .ts files)
electron/*.js
electron/*.js.map
dist-electron/
